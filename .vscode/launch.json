{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MeetingRoom API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build MeetingRoom API",
      "program": "${workspaceFolder}/Abp.MeetingRoom.Services.Web/bin/Debug/net10.0/Abp.MeetingRoom.Services.Web.dll",
      "cwd": "${workspaceFolder}/Abp.MeetingRoom.Services.Web",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5119",
        "PATH": "C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin;${env:PATH}"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
